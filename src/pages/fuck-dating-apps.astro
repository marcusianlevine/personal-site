		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.lede {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		max-width: 42ch;
		margin-inline: auto;
		text-align: center;
		font-family: var(--font-brand);
		font-style: italic;
		font-size: var(--text-lg);
		line-height: 1.35;
		color: var(--gray-100);
	}

