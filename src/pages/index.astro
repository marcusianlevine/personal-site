---
import { Icon as AstroIcon } from 'astro-icon/components';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
// Layout import - provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout
	title="Marcus Levine | Relationship Coach"
	description="Bringing back in-person dating. Coaching for people who are fed up with the apps and want to approach the people they're attracted to - calmly, confidently, respectfully."
>
	<div class="stack gap-20 lg:gap-20">
		<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hi, I'm Marcus"
					tagline="I train you to respectfully approach people you're attracted to."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="heart" size="1.33em" /> Coach</Pill>
						<Pill><AstroIcon name="mdi:lightbulb-on-outline" size="1.33em" /> Philosopher</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Writer</Pill>
					</div>
				</Hero>

				<img
					alt="Marcus Levine smiling in a green shirt"
					width="480"
					height="620"
					src="/assets/portrait.jpg"
				/>
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-30">
			<section class="section">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Bring back in-person dating</h3>
					<p>
						Dating apps make money when you keep swiping, not when you find someone.
					</p>
					<p>
						Instead, develop authentic approach skills,
						nervous-system regulation, and the emotional maturity to
						meet someone face-to-face, eye-to-eye.
					</p>
					<p class="pull">
						<i><b>Rejection is information, not failure.</b></i>
					</p>
				</header>

				<div class="paths">
					<article class="path-card">
						<p class="path-label">Start here - free</p>
						<h4>Fuck Dating Apps</h4>
						<p>
							Why the apps are built to keep you swiping, and what to do
							instead. Free field note, one page.
						</p>
						<CallToAction href="/fuck-dating-apps/">
							Read the field note
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</article>

					<article class="path-card">
						<p class="path-label">The deep work - 3 months, 1:1</p>
						<h4>Authentic Approach</h4>
						<p>
							Learn to approach people you're attracted to with respect and calm. Somatic tools, weekly real-world reps, and a coach
							in your corner for the scary moments. No pickup lines. No creepiness.
						</p>
						<CallToAction href="/authentic-approach/">
							Explore the container
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</article>
				</div>
			</section>
		</main>

		</div>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		justify-content: center;
	}

	.hero img {
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	:global(html.theme-dark) .hero img {
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			align-items: flex-start;
			justify-content: flex-start;
			margin-top: 0.5rem;
		}

		.hero img {
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 60ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	.paths {
		display: grid;
		gap: 1.5rem;
		max-width: 70rem;
		margin-inline: auto;
		width: 100%;
	}

	.path-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		min-width: 0;
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		color: var(--gray-200);
	}

	.path-card :global(a) {
		white-space: normal;
	}

	.path-label {
		font-size: var(--text-sm);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--accent-regular);
	}

	.path-card h4 {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.paths {
			grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
			gap: 2rem;
		}

		.path-card {
			padding: 2.5rem;
		}
	}
</style>
