---
/**
 * Site-wide strip announcing the next live webinar. Driven entirely by src/config/webinar.ts:
 * it renders only while `nextWebinar.date` is set and in the future (decided at build time),
 * and a small inline check also hides it client-side if the date passed since the last deploy.
 * Not shown on the webinar page itself.
 */
import { upcomingWebinar, webinarDateLabel } from '../config/webinar';

const webinar = upcomingWebinar();
const onWebinarPage = Astro.url.pathname.replace(/\/$/, '') === webinar?.url.replace(/\/$/, '');
---

{
	webinar && !onWebinarPage && (
		<div id="webinar-banner" class="webinar-banner" data-until={webinar.date}>
			<a href={webinar.url} class="webinar-banner-link">
				<span class="webinar-banner-text">
					<strong>Free live webinar:</strong> {webinar.title}, {webinarDateLabel(webinar)}
				</span>
				<span class="webinar-banner-cta">Save your spot →</span>
			</a>
		</div>
		<script is:inline>
			(function () {
				var el = document.getElementById('webinar-banner');
				if (el && new Date(el.dataset.until) <= new Date()) el.remove();
			})();
		</script>
	)
}

<style>
	.webinar-banner {
		width: 100%;
		background: var(--gradient-accent-orange);
	}

	.webinar-banner-link {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.25rem 0.75rem;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		text-align: center;
		color: var(--accent-text-over);
		text-decoration: none;
	}

	.webinar-banner-link:hover,
	.webinar-banner-link:focus {
		text-decoration: underline;
	}

	.webinar-banner-cta {
		font-weight: 600;
		white-space: nowrap;
	}
</style>
